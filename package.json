{
  "name": "scanning-tailwind",
  "version": "1.0.0",
  "description": "Tailwind CSS build for FLP Scanning Portal",
  "scripts": {
    "start": "npm run dev",
    "build": "npm run build:clean && npm run build:tailwind && npm run build:fa",
    "build:clean": "rimraf scanning/assets/static-global/css/tailwind_styles.css",
    "build:tailwind": "cross-env NODE_ENV=production tailwindcss --config ./scanning/assets/tailwind/tailwind.config.js -i ./scanning/assets/tailwind/input.css -o ./scanning/assets/static-global/css/tailwind_styles.css --minify",
    "build:fa": "npm run build:fa:css && npm run build:fa:fonts",
    "build:fa:css": "cp node_modules/@fortawesome/fontawesome-free/css/all.min.css scanning/assets/static-global/css/fontawesome-all.min.css",
    "build:fa:fonts": "cp -r node_modules/@fortawesome/fontawesome-free/webfonts scanning/assets/static-global/",
    "dev": "cross-env NODE_ENV=development tailwindcss --config ./scanning/assets/tailwind/tailwind.config.js -i ./scanning/assets/tailwind/input.css -o ./scanning/assets/static-global/css/tailwind_styles.css -w"
  },
  "devDependencies": {
    "@fortawesome/fontawesome-free": "^6.7.2",
    "cross-env": "^7.0.3",
    "rimraf": "^6.0.0",
    "tailwindcss": "^3.4.17"
  }
}
