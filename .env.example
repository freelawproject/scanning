# Django
SECRET_KEY=change-me-to-a-real-secret-key
DEBUG=True
DEVELOPMENT=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database
DB_HOST=scanning-postgres
DB_NAME=scanning
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSL_MODE=prefer

# AWS / S3
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_STORAGE_BUCKET_NAME=

# Sentry
# SENTRY_DSN=

# Logging
# Verbosity of the "scanning" logger. Default INFO. Set to DEBUG to
# see every RunPod poll tick, SQL queries, and other verbose traces.
# SCANNING_LOG_LEVEL=INFO

# RunPod Serverless (GPU offload for detect / analyze_pdf)
# Leave RUNPOD_ENABLED=False in dev and CI; the daemon falls through
# to running blackletter in-process. Flip to True in staging / prod
# once the endpoint below is configured.
# RUNPOD_ENABLED=False
# RUNPOD_ENDPOINT_ID=
# RUNPOD_API_KEY=
# Hard wall-clock ceiling (seconds) for submit + poll. Covers cold
# start + queue + execution. Default 1800.
# RUNPOD_REQUEST_TIMEOUT=1800
# Transport-error retries on /run (network blips, 5xx). Terminal job
# failures are never retried. Default 2.
# RUNPOD_MAX_RETRIES=2
# Lifetime of presigned GET URLs handed to the worker (seconds).
# Default 86400 (1 day); generous headroom so a URL never expires
# before the worker fetches it. AWS SigV4 max is 7 days.
# RUNPOD_PRESIGNED_TTL=86400
# Max transient RunPod failures (NO_GPU, 404) before a scan escalates
# to ERROR instead of being re-queued. Default 5.
# RUNPOD_MAX_TRANSIENT_RETRIES=5
