# Django
SECRET_KEY=change-me-to-a-real-secret-key
DEBUG=True
DEVELOPMENT=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database
DB_HOST=scanning-postgres
DB_NAME=scanning
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSL_MODE=prefer

# AWS / S3
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_STORAGE_BUCKET_NAME=
# Region both buckets live in. Presigned URLs are SigV4, which signs
# the region into the credential scope, so this must match or S3
# rejects them. Default us-west-2.
# AWS_S3_REGION_NAME=us-west-2

# Sentry
# SENTRY_DSN=

# Logging
# Verbosity of the "scanning" logger. Default INFO. Set to DEBUG to
# see every RunPod poll tick, SQL queries, and other verbose traces.
# SCANNING_LOG_LEVEL=INFO

# PDF sharding (issue #164)
# The original is cut into shards so external workers can process page
# ranges in parallel. Retuning either bound does NOT re-shard volumes
# already sharded: a stored set is recomputed only when its source PDF
# changes.
# SHARDING_ENABLED=True
# Target bytes per shard (default 200 MB): guards a reader's download
# and ephemeral disk.
# SHARD_TARGET_BYTES=209715200
# Ceiling on pages per shard (default 100): guards conversion time,
# which is per page. Without it a compact already-bitonal volume
# becomes one multi-minute request.
# SHARD_MAX_PAGES=100

# Doctor (bitonal conversion, issue #176)
# On by default, so a deploy converts without an env change. With it
# off a scan is uploaded and sharded but not converted, and the viewer
# serves the original: there is no in-process fallback (issue #173).
#
# The pipeline also requires S3 to be active before creating any job,
# since doctor reads the shard through a presigned GET, so CI and a dev
# environment without AWS credentials are inert either way. A dev
# environment *with* credentials dispatches for real, and the
# in-cluster host below will not resolve from a laptop -- set this
# False locally unless you have a reachable doctor.
# DOCTOR_ENABLED=True
# Base URL, no trailing slash. Defaults to the shared CourtListener
# instance, so DOCTOR_ENABLED is the only switch in the cluster. Fully
# qualified because an unqualified `cl-doctor` does not resolve from
# the `scanning` namespace.
# DOCTOR_HOST=http://cl-doctor.court-listener.svc.cluster.local:5050
# Conversion parameters. The defaults reproduce the retired in-process
# pass (blackletter's 200/160), not doctor's own 300/128.
# DOCTOR_BITONAL_DPI=200
# DOCTOR_BITONAL_THRESHOLD=160
# Conversions in flight at once, and so rows claimed per submit tick.
# A doctor pod converts one shard at a time, so the real ceiling is its
# replica count (~52 in production). Default 8.
# DOCTOR_MAX_CONCURRENCY=8
# Connect / read timeouts (seconds), default 5 and 300. Abandoning the
# read does not abandon the work -- doctor finishes and uploads anyway
# -- which is why a lost response is recovered with an S3 HEAD.
# DOCTOR_CONNECT_TIMEOUT=5
# DOCTOR_READ_TIMEOUT=300
# Wall-clock ceiling (seconds) for one submitted attempt. Default 900.
# DOCTOR_JOB_DEADLINE_SECONDS=900
# Attempts per shard before its job fails. Default 3: doctor runs on
# spot nodes and redeploys often, so losing one is routine.
# DOCTOR_MAX_ATTEMPTS=3
# Lifetime (seconds) of the presigned GET/PUT handed to doctor.
# Default 86400 (1 day); AWS SigV4 max is 7 days.
# DOCTOR_PRESIGNED_TTL=86400

# Daemon
# How often (seconds) the daemon checks for queued scans. Default 5.
# DAEMON_POLL_INTERVAL=5
# How long (seconds) before a PROCESSING scan is stale and re-queued.
# Default 3600.
# DAEMON_PROCESSING_TIMEOUT=3600
# Re-queues a scan may survive before it is flagged ERROR_INTERRUPTED.
# Default 5.
# DAEMON_MAX_INTERRUPTIONS=5
# How often (seconds) the daemon submits a wave of external jobs, and
# confirms in-flight ones. Defaults 5 and 15.
# DAEMON_SUBMIT_INTERVAL=5
# DAEMON_COLLECT_INTERVAL=15
# How long (seconds) an unsubmitted job may wait before it is written
# off. Default 21600 (6 hours).
# DAEMON_JOB_MAX_QUEUE_SECONDS=21600

# RunPod Serverless (GPU job dispatch)
# Leave RUNPOD_ENABLED=False in dev and CI: there is no in-process
# fallback (removed with the legacy pipeline, issue #173), so a dev
# environment without RunPod uploads and browses but does not process.
# Flip to True in staging / prod once the endpoint below is configured.
# RUNPOD_ENABLED=False
# RUNPOD_ENDPOINT_ID=
# RUNPOD_API_KEY=
# Hard wall-clock ceiling (seconds) for submit + poll. Covers cold
# start + queue + execution. Default 1800.
# RUNPOD_REQUEST_TIMEOUT=1800
# Transport-error retries on /run (network blips, 5xx). Terminal job
# failures are never retried. Default 2.
# RUNPOD_MAX_RETRIES=2
# Lifetime of the presigned URLs handed to the worker (seconds), both
# the GET for the input PDF and the PUT for the result. Default 86400
# (1 day); generous headroom so neither expires before the worker gets
# to it. AWS SigV4 max is 7 days.
# RUNPOD_PRESIGNED_TTL=86400
# Max transient RunPod failures (NO_GPU, 404) before a scan escalates
# to ERROR instead of being re-queued. Default 5.
# RUNPOD_MAX_TRANSIENT_RETRIES=5
