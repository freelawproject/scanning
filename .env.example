# Django
SECRET_KEY=change-me-to-a-real-secret-key
DEBUG=True
DEVELOPMENT=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database
DB_HOST=scanning-postgres
DB_NAME=scanning
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSL_MODE=prefer

# AWS / S3
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_STORAGE_BUCKET_NAME=
# Region both buckets live in. Presigned URLs are SigV4, which signs
# the region into the credential scope, so this must match or S3
# rejects them. Default us-west-2.
# AWS_S3_REGION_NAME=us-west-2

# Sentry
# SENTRY_DSN=

# Logging
# Verbosity of the "scanning" logger. Default INFO. Set to DEBUG to
# see every RunPod poll tick, SQL queries, and other verbose traces.
# SCANNING_LOG_LEVEL=INFO

# RunPod Serverless (GPU offload for detect / analyze_pdf)
# Leave RUNPOD_ENABLED=False in dev and CI; the daemon falls through
# to running blackletter in-process. Flip to True in staging / prod
# once the endpoint below is configured.
# RUNPOD_ENABLED=False
# RUNPOD_ENDPOINT_ID=
# RUNPOD_API_KEY=
# Hard wall-clock ceiling (seconds) for submit + poll. Covers cold
# start + queue + execution. Default 1800.
# RUNPOD_REQUEST_TIMEOUT=1800
# Transport-error retries on /run (network blips, 5xx). Terminal job
# failures are never retried. Default 2.
# RUNPOD_MAX_RETRIES=2
# Lifetime of the presigned URLs handed to the worker (seconds), both
# the GET for the input PDF and the PUT for the result. Default 86400
# (1 day); generous headroom so neither expires before the worker gets
# to it. AWS SigV4 max is 7 days.
# RUNPOD_PRESIGNED_TTL=86400
# Max transient RunPod failures (NO_GPU, 404) before a scan escalates
# to ERROR instead of being re-queued. Default 5.
# RUNPOD_MAX_TRANSIENT_RETRIES=5

# Daemon scheduling
# How often (seconds) each task in run_daemon fires.
# DAEMON_POLL_INTERVAL=5
# DAEMON_ADVANCE_INTERVAL=10
# DAEMON_SUBMIT_INTERVAL=5
# DAEMON_COLLECT_INTERVAL=15
# How long (seconds) before a PROCESSING scan is treated as stale and
# re-queued. Only PROCESSING: a scan waiting on external jobs is
# AWAITING, which no process is holding, so this must not apply to it.
# Default 3600.
# DAEMON_PROCESSING_TIMEOUT=3600
# How many times a scan may be re-queued after the daemon was killed
# mid-pipeline before it is flagged ERROR_INTERRUPTED. Default 5.
# DAEMON_MAX_INTERRUPTIONS=5

# Batch cycle (issue #156)
# Master switch. With it off, every GPU step blocks until it comes back
# and one scan is in flight per daemon, exactly as before. With it on,
# steps submit jobs and the daemon polls them, so a batch of volumes
# runs at once. Needs RUNPOD_ENABLED and AWS credentials to take effect,
# since a batched result is delivered by presigned PUT and read back on
# a later tick. Default False.
# DAEMON_BATCH_JOBS=False
# How many queued scans one claim tick may take. 0 means every scan
# queued at the moment of the snapshot. Only consulted when
# DAEMON_BATCH_JOBS is on. Default 0.
# DAEMON_BATCH_SIZE=0
# Deadline allowance (seconds) per page a job covers, added to
# RUNPOD_REQUEST_TIMEOUT once the job starts running. Default 1.0.
# DAEMON_JOB_SECONDS_PER_PAGE=1.0
# How long (seconds) a job may wait to start before it is written off,
# covering both time queued behind the provider's worker cap and time
# spent pending because the endpoint kept refusing work. Sized for queue
# time, not execution: batching against a narrow pool means a long queue
# is the design working. Default 21600 (6h).
# DAEMON_JOB_MAX_QUEUE_SECONDS=21600
